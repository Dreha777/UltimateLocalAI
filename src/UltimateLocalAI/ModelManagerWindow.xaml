<Window x:Class="UltimateLocalAI.ModelManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Менеджер моделей" Width="1180" Height="720" MinWidth="940" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgBrush}">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Менеджер локальных GGUF-моделей" FontSize="22" FontWeight="SemiBold"/>
                <TextBlock Text="Программа читает метаданные GGUF локально и оценивает качество квантования и совместимость с этим ПК. Оценка RAM/VRAM ориентировочная — фактический расход зависит от архитектуры, context и backend."
                           Foreground="{DynamicResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,5,16,0"/>
            </StackPanel>
            <Button Grid.Column="1" Content="Обновить" Style="{StaticResource SoftButton}" Click="Scan_Click" VerticalAlignment="Center"/>
        </Grid>

        <Border Grid.Row="1" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                CornerRadius="12" Padding="10" Margin="0,14,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Папка моделей:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <ComboBox Grid.Column="1" x:Name="FoldersBox" ItemsSource="{Binding ModelFolders}" MinWidth="320"/>
                <Button Grid.Column="3" Content="＋ Добавить папку" Style="{StaticResource SoftButton}" Click="AddFolder_Click"/>
                <Button Grid.Column="5" Content="Убрать" Style="{StaticResource SoftButton}" Click="RemoveFolder_Click"/>
            </Grid>
        </Border>

        <Border Grid.Row="2" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="38"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Grid Background="{DynamicResource ControlBrush}" Margin="1" Height="36">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2.1*"/><ColumnDefinition Width="78"/><ColumnDefinition Width="105"/>
                        <ColumnDefinition Width="95"/><ColumnDefinition Width="85"/><ColumnDefinition Width="125"/>
                        <ColumnDefinition Width="2.3*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Модель" FontWeight="SemiBold" Margin="10,0" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="Размер" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="Архитектура" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="3" Text="Квант." FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="4" Text="Context" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="5" Text="Качество" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="6" Text="Оценка на этом ПК" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </Grid>

                <ListBox Grid.Row="1" x:Name="ModelsList" ItemsSource="{Binding Models}" Background="Transparent" BorderThickness="0"
                         SelectionChanged="ModelsList_SelectionChanged" MouseDoubleClick="ModelsList_MouseDoubleClick"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0,1"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource AttachmentBrush}"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid MinHeight="48" Margin="0,1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2.1*"/><ColumnDefinition Width="78"/><ColumnDefinition Width="105"/>
                                    <ColumnDefinition Width="95"/><ColumnDefinition Width="85"/><ColumnDefinition Width="125"/>
                                    <ColumnDefinition Width="2.3*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="10,5,8,5" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding FullPath}" FontSize="9" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding SizeText}" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Architecture}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding SizeLabel}" FontSize="9" Foreground="{DynamicResource MutedBrush}"/>
                                </StackPanel>
                                <TextBlock Grid.Column="3" Text="{Binding Quantization}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="4" Text="{Binding NativeContextText}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="5" Text="{Binding Quality}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                <TextBlock Grid.Column="6" Text="{Binding HardwareFit}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,8,0"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <Grid Grid.Row="3" Margin="0,10,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
            <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="12">
                <StackPanel>
                    <TextBlock Text="Советник" FontWeight="SemiBold"/>
                    <TextBlock x:Name="AdviceText" Text="Выберите модель в списке." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,5,0,0"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="12">
                <StackPanel>
                    <TextBlock Text="Профиль Auto" FontWeight="SemiBold"/>
                    <ComboBox x:Name="ProfileBox" Margin="0,6,0,0" SelectionChanged="ProfileBox_SelectionChanged">
                        <ComboBoxItem Content="Качество"/>
                        <ComboBoxItem Content="Баланс"/>
                        <ComboBoxItem Content="Экономия"/>
                    </ComboBox>
                    <TextBlock x:Name="ProfileHintText" Foreground="{DynamicResource MutedBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="4" Margin="0,12,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}"/>
            <Button Grid.Column="1" Content="Закрыть" Style="{StaticResource SoftButton}" Click="Close_Click"/>
            <Button Grid.Column="3" Content="Сохранить настройки" Style="{StaticResource SoftButton}" Click="Save_Click"/>
            <Button Grid.Column="5" x:Name="UseButton" Content="Использовать выбранную" Style="{StaticResource AccentButton}" Click="UseSelected_Click" IsEnabled="False"/>
        </Grid>
    </Grid>
</Window>