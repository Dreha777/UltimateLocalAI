<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>UltimateLocalAI</AssemblyName>
    <RootNamespace>UltimateLocalAI</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Product>Ultimate Local AI</Product>
    <Authors>Dreha777</Authors>
    <Description>Портативный Windows-клиент для локального запуска GGUF-моделей через llama.cpp с автоматическим подбором CPU/GPU backend и параметров.</Description>
    <Copyright>Copyright © Dreha777</Copyright>
  </PropertyGroup>
</Project>
