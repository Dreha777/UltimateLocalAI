<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>UltimateLocalAI</AssemblyName>
    <RootNamespace>UltimateLocalAI</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Product>Ultimate Local AI</Product>
    <Authors>Яхлов Андрей Васильевич</Authors>
    <Description>Портативный офлайн Windows-клиент для локального запуска GGUF-моделей через llama.cpp с автоматическим подбором CPU/GPU backend и параметров для разнородных и маломощных ПК.</Description>
    <Copyright>Copyright © Яхлов Андрей Васильевич</Copyright>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="WpfMath" Version="2.1.0" />
    <PackageReference Include="PDFsharp-MigraDoc-WPF" Version="6.2.4" />
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
    <PackageReference Include="PdfPig" Version="0.1.6" />
  </ItemGroup>
</Project>
