<Window x:Class="UltimateLocalAI.KnowledgeBaseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Локальная база знаний / RAG" Width="940" Height="680" MinWidth="820" MinHeight="560"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource BgBrush}">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Локальная база знаний · RAG 2.0" FontSize="22" FontWeight="SemiBold"/>
            <TextBlock Text="Stage 7G-1 создаёт настоящий семантический индекс: документ → chunks → embeddings → локальные векторы. На этой стадии чат ещё использует прежний поиск; подключение semantic retrieval будет в 7G-2."
                       TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,5,0,0"/>
        </StackPanel>

        <Border Grid.Row="1" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                CornerRadius="12" Padding="12" Margin="0,14,0,12">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>

                <TextBlock Text="Embedding GGUF" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <TextBox Grid.Column="1" x:Name="EmbeddingModelPathBox" IsReadOnly="True" ToolTip="Отдельная embedding-модель GGUF; обычная chat-модель для этого обычно не подходит."/>
                <Button Grid.Column="3" Content="Выбрать…" Style="{StaticResource SoftButton}" Click="SelectEmbeddingModel_Click"/>

                <TextBlock Grid.Row="1" Text="Префикс документов" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,8,0,0"/>
                <TextBox Grid.Row="1" Grid.Column="1" x:Name="DocumentPrefixBox" Margin="0,8,0,0" ToolTip="Оставьте пустым, если документация embedding-модели не требует passage/document prefix."/>
                <TextBlock Grid.Row="1" Grid.Column="3" Text="например: passage: " Foreground="{DynamicResource MutedBrush}" FontSize="10" VerticalAlignment="Center" Margin="0,8,0,0"/>

                <TextBlock Grid.Row="2" Text="Префикс запроса" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,8,0,0"/>
                <TextBox Grid.Row="2" Grid.Column="1" x:Name="QueryPrefixBox" Margin="0,8,0,0" ToolTip="Будет использоваться в 7G-2 для embedding поискового запроса."/>
                <TextBlock Grid.Row="2" Grid.Column="3" Text="например: query: " Foreground="{DynamicResource MutedBrush}" FontSize="10" VerticalAlignment="Center" Margin="0,8,0,0"/>
            </Grid>
        </Border>

        <Border Grid.Row="2" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="36"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Grid Background="{DynamicResource ControlBrush}" Margin="1">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="90"/><ColumnDefinition Width="90"/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Документ" FontWeight="SemiBold" Margin="10,0" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="Страницы" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="Chunks" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="3" Text="Индекс" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </Grid>

                <ListBox Grid.Row="1" x:Name="DocsList" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource AttachmentBrush}"/></Trigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid MinHeight="50" Margin="0,1">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="90"/><ColumnDefinition Width="90"/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions>
                                <StackPanel Margin="10,5">
                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding SourcePath}" FontSize="9" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding PageCount}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="{Binding ChunkCount}" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="3" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding IndexStatus}"/>
                                    <TextBlock Text="{Binding IndexedAt, StringFormat={}{0:dd.MM.yyyy HH:mm}}" FontSize="9" Foreground="{DynamicResource MutedBrush}"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="StatusText" Foreground="{DynamicResource MutedBrush}"/>
                <TextBlock x:Name="IndexInfoText" Foreground="{DynamicResource MutedBrush}" FontSize="10" Margin="0,3,0,0"/>
            </StackPanel>
            <Button Grid.Column="1" x:Name="ClearButton" Style="{StaticResource SoftButton}" Content="Очистить RAG индекс" Click="Clear_Click"/>
            <Button Grid.Column="3" x:Name="RemoveButton" Style="{StaticResource SoftButton}" Content="Удалить выбранный" Click="Remove_Click"/>
            <Button Grid.Column="5" x:Name="AddButton" Style="{StaticResource AccentButton}" Content="Добавить / индексировать" Click="Add_Click"/>

            <ProgressBar Grid.Row="1" Grid.ColumnSpan="6" x:Name="ProgressBar" Height="4" Margin="0,10,0,0" Minimum="0" Maximum="100" Visibility="Collapsed"/>
        </Grid>
    </Grid>
</Window>