<Window x:Class="UltimateLocalAI.DocumentVisionPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:UltimateLocalAI.Controls"
        Title="Document Vision · анализ страницы" Width="1180" Height="820" MinWidth="920" MinHeight="640"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource BgBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock x:Name="TitleText" FontSize="21" FontWeight="SemiBold"/>
            <TextBlock x:Name="StatusText" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,10"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.92*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="1.08*"/>
            </Grid.ColumnDefinitions>

            <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    CornerRadius="10" Padding="8">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <TextBlock Text="Страница, переданная vision-модели" FontWeight="SemiBold" Margin="2,0,0,7"/>
                    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                        <Image x:Name="PageImage" Stretch="Uniform"/>
                    </ScrollViewer>
                </Grid>
            </Border>

            <Border Grid.Column="2" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    CornerRadius="10" Padding="12">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <controls:RichMessageControl x:Name="VisionResult" Role="assistant"/>
                </ScrollViewer>
            </Border>
        </Grid>

        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Text="Vision дополняет OCR: формулы → LaTeX, таблицы → Markdown, графики/схемы → структурированное описание. Неразборчивые значения модель должна помечать явно."
                       Foreground="{DynamicResource MutedBrush}" FontSize="10" TextWrapping="Wrap" VerticalAlignment="Center"/>
            <Button Grid.Column="1" Content="Закрыть" Style="{StaticResource AccentButton}" Click="Close_Click"/>
        </Grid>
    </Grid>
</Window>